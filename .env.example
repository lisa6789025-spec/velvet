# Flush messenger integration (see flushmessenger app in the same folder)
# Shared secret that flushmessenger sends as "x-flush-secret" on /api/flush.
# Leave empty to allow requests from anywhere (local dev only).
FLUSH_SECRET=
# Override the app name flushmessenger displays. Defaults to the folder name.
FLUSH_APP_NAME=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated fallbacks tried in order when a model hits its rate limit
# or errors out. Free-tier limits are per-model, so a fresh model = fresh quota.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant,qwen/qwen3.6-27b,meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter (openrouter.ai — free-tier models, ~50 requests/day each)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated free models, tried after the Groq chain is exhausted
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-small-24b-instruct:free,google/gemini-2.5-flash:free

# Google Gemini (aistudio.google.com → Get API key — free tier on Flash models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# AI Detector chain (tried in order until one returns a score):
# 1. Winston AI (free tier: 2,000 credits, ~1 credit/word, no credit card)
#    Get a key at https://dev.gowinston.ai -> API / Tokens -> create token
WINSTON_API_KEY=
# 2. Gemini (reuses GEMINI_API_KEY above as a last-resort estimate — no key needed)

# PayPal (developer.paypal.com → Apps & Credentials)
# Server-side: used by /api/paypal/create-order and /api/paypal/capture-order
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client-side: used to load the PayPal JS SDK buttons.
# Usually the same value as PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "sandbox" while testing, "live" when you're ready for real payments
PAYPAL_ENV=sandbox
